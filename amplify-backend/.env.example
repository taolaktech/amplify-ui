# Server Configuration
PORT=4000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/amplify-dashboard

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET_NAME=amplify-templates

# Firebase Configuration (for auth validation)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# Google Gemini Configuration
GEMINI_API_KEY=AIzaSyDTmJDf6c7kl78oRasxk99SU1NVuOjiTnk
GEMINI_MODEL=gemini-1.5-pro

# Amplify Wallet API (existing backend for auth/subscriptions)
AMPLIFY_WALLET_API_URL=https://dev-wallet.useamplify.ai

# Logging Configuration
